# ═══════════════════════════════════════════════════════════════
# Cloud production — uidrac.cloud.conzex.com (copy to .env on server)
# VPS / Docker recommended. See docs/DEPLOYMENT.md for cPanel & local VM.
# ═══════════════════════════════════════════════════════════════

DEPLOYMENT_MODE=cloud
REQUIRE_EDGE_AGENT=true

# Public URLs (HTTPS, no trailing slash)
PUBLIC_APP_URL=https://uidrac.cloud.conzex.com
PUBLIC_API_URL=https://uidrac.cloud.conzex.com
NEXT_PUBLIC_APP_URL=https://uidrac.cloud.conzex.com
NEXT_PUBLIC_API_URL=https://uidrac.cloud.conzex.com/api
NEXT_PUBLIC_CONSOLE_URL=https://uidrac.cloud.conzex.com/console
CORS_ORIGINS=https://uidrac.cloud.conzex.com

# ── Database (Postgres 16) ──
POSTGRES_USER=idrac
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=idrac
POSTGRES_URL=postgresql://idrac:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/idrac

# ── Redis ──
REDIS_URL=redis://redis:6379

# ── Secrets (openssl rand -base64 64 / openssl rand -hex 32) ──
JWT_SECRET=CHANGE_ME
REFRESH_SECRET=CHANGE_ME
MASTER_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
AGENT_SIGNING_SECRET=CHANGE_ME

# ── SMTP (required in production for admin password reset emails) ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@uidrac.cloud.conzex.com

# ── TLS (nginx in docker-compose.prod.yml) ──
TLS_CERT_PATH=./nginx/certs/fullchain.pem
TLS_KEY_PATH=./nginx/certs/privkey.pem

NODE_ENV=production
