# ═══════════════════════════════════════════════════════════════
# Self-hosted VM — production Docker (copy to .env on your server)
# See README.md and docs/DEPLOYMENT.md
# ═══════════════════════════════════════════════════════════════

DEPLOYMENT_MODE=selfhosted
REQUIRE_EDGE_AGENT=false

# Replace with your public URL (HTTPS, no trailing slash)
# Examples: https://idrac.company.com  or  https://10.0.0.50 (self-signed cert)
PUBLIC_APP_URL=https://idrac.yourdomain.com
PUBLIC_API_URL=https://idrac.yourdomain.com
NEXT_PUBLIC_APP_URL=https://idrac.yourdomain.com
NEXT_PUBLIC_API_URL=https://idrac.yourdomain.com/api
NEXT_PUBLIC_CONSOLE_URL=https://idrac.yourdomain.com/console
CORS_ORIGINS=https://idrac.yourdomain.com

# ── Database (Postgres 16 — internal Docker network) ──
POSTGRES_USER=idrac
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=idrac
POSTGRES_URL=postgresql://idrac:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/idrac

# ── Redis ──
REDIS_URL=redis://redis:6379

# ── Secrets: run  bash scripts/generate-keys.sh  and paste below ──
JWT_SECRET=CHANGE_ME
REFRESH_SECRET=CHANGE_ME
MASTER_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# Optional; falls back to JWT_SECRET if unset (edge agent not required on LAN)
# AGENT_SIGNING_SECRET=CHANGE_ME

# Optional Cloudflare Tunnel in Docker (see docs/CLOUDFLARE-TUNNEL.md)
# CLOUDFLARE_TUNNEL_TOKEN=

# ── TLS (paths on the VM, mounted into nginx container) ──
TLS_CERT_PATH=./nginx/certs/fullchain.pem
TLS_KEY_PATH=./nginx/certs/privkey.pem

# ── Console gateway (legacy iDRAC 6/7) ──
IDRAC_CONSOLE_IMAGE=uidrac:legacy
CONSOLE_IDLE_TIMEOUT=1800
CONSOLE_MAX_PER_TENANT=10

NODE_ENV=production
