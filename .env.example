# ═══════════════════════════════════════════════════════════════
# Universal iDRAC Console — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── Database (Postgres 16) ──
POSTGRES_USER=idrac
POSTGRES_PASSWORD=7PNmGDZ6pU0QPoAQenj7agTpPXjHdkiTcks2DXi84
POSTGRES_DB=idrac
POSTGRES_URL=postgresql://idrac:changeme_db_password@postgres:5432/idrac

# ── Redis 7 ──
REDIS_URL=redis://redis:6379

# ── JWT Secrets (generate with: openssl rand -base64 64) ──
JWT_SECRET=SnmuR9fewcdBTiAkaHID3SWzl2lVVC3iNHwkchdjXwUFVZcO/Nbn60yrPN9uLuKulfS0PMkXm0/SBv+I26mKHA==
REFRESH_SECRET=PjT+milT6544x7metrFVrm6wsPBAfA8Op8c52RpxvEIN/yS0Aiyk2uol1sPUNWJoGYKXdEYDuLpshHHs8y/hyg==

# ── iDRAC Credential Encryption ──
# Master key for AES-256-GCM encryption of stored iDRAC credentials.
# Generate with: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=6176c1a2ca8fd23b03aa98d9e744c2e43f9f65ac132e6925a278aa95c6323b20

# ── Application URLs ──
NEXT_PUBLIC_API_URL=https://idrac.example.com/api
NEXT_PUBLIC_CONSOLE_URL=https://idrac.example.com/console
NEXT_PUBLIC_APP_URL=https://idrac.example.com

# ── SMTP (for magic links, alerts, password reset) ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=changeme_smtp_password
SMTP_FROM="Universal iDRAC Console <noreply@example.com>"

# ── Console Gateway ──
# Docker image used for legacy iDRAC 6/7 Java console containers.
IDRAC_CONSOLE_IMAGE=universal-idrac-console:legacy
# Max idle time before auto-stopping console containers (seconds).
CONSOLE_IDLE_TIMEOUT=1800
# Max concurrent console containers per tenant.
CONSOLE_MAX_PER_TENANT=10

# ── TLS (if not using Traefik/certbot) ──
# TLS_CERT_PATH=/etc/ssl/certs/idrac.crt
# TLS_KEY_PATH=/etc/ssl/private/idrac.key

# ── Traefik (optional, for multi-tenant wildcard routing) ──
# TRAEFIK_ACME_EMAIL=admin@example.com
# TRAEFIK_DOMAIN=idrac.example.com

# ── Rate Limiting ──
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW_MS=60000

# ── Node Environment ──
NODE_ENV=production
