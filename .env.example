# ═══════════════════════════════════════════════════════════════
# Universal iDRAC Console — local / lab Docker (docker compose up)
# Config slug / images: uidrac (see IDRAC_CONSOLE_IMAGE, COMPOSE_PROJECT_NAME)
# Copy to .env:  cp .env.example .env
# Generate secrets:  bash scripts/generate-keys.sh
# For production on a VM use:  cp .env.selfhosted.example .env
# Cloud (edge agent):  cp .env.cloud.example .env
# ═══════════════════════════════════════════════════════════════

# ── Database (Postgres 16) ──
POSTGRES_USER=idrac
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=idrac
POSTGRES_URL=postgresql://idrac:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/idrac

# ── Redis 7 ──
REDIS_URL=redis://redis:6379

# ── JWT (openssl rand -base64 64) ──
JWT_SECRET=CHANGE_ME
REFRESH_SECRET=CHANGE_ME

# ── iDRAC credential encryption (openssl rand -hex 32) ──
MASTER_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# ── Self-hosted LAN (default for docker-compose.yml) ──
DEPLOYMENT_MODE=selfhosted
REQUIRE_EDGE_AGENT=false

# Browser URLs when using exposed ports 3000 / 4000 / 6080
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_CONSOLE_URL=http://localhost:6080/console
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Console gateway ──
IDRAC_CONSOLE_IMAGE=uidrac:legacy
CONSOLE_IDLE_TIMEOUT=1800
CONSOLE_MAX_PER_TENANT=10

# ── SMTP (optional — alerts / mail) ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=CHANGE_ME
# SMTP_FROM="Universal iDRAC Console <noreply@example.com>"

NODE_ENV=development
