# Conzex SaaS production — use with docker-compose.prod.yml + docker-compose.saas.yml
#   cp .env.saas.example .env && bash scripts/generate-keys.sh --write

POSTGRES_USER=idrac
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=idrac

JWT_SECRET=CHANGE_ME
REFRESH_SECRET=CHANGE_ME
MASTER_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
AGENT_SIGNING_SECRET=CHANGE_ME

DEPLOYMENT_MODE=cloud
REQUIRE_EDGE_AGENT=true

# Public URLs (TLS via nginx — adjust for your domain)
PUBLIC_APP_URL=https://uidrac.example.com
PUBLIC_API_URL=https://uidrac.example.com
NEXT_PUBLIC_APP_URL=https://uidrac.example.com
NEXT_PUBLIC_API_URL=https://uidrac.example.com/api
NEXT_PUBLIC_CONSOLE_URL=https://uidrac.example.com/console
CORS_ORIGINS=https://uidrac.example.com

IDRAC_CONSOLE_IMAGE=uidrac:legacy
TLS_CERT_PATH=./nginx/certs/fullchain.pem
TLS_KEY_PATH=./nginx/certs/privkey.pem
