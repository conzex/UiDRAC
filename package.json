{
  "name": "uidrac",
  "version": "1.3.2",
  "private": true,
  "description": "Universal iDRAC Console — Conzex Docker-hosted fleet management (iDRAC 6–9)",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @idrac/db generate",
    "db:migrate": "pnpm --filter @idrac/db migrate",
    "db:seed": "pnpm --filter @idrac/db seed",
    "db:studio": "pnpm --filter @idrac/db studio",
    "docker:dev": "docker compose up -d",
    "docker:rebuild": "bash scripts/dev-rebuild.sh",
    "docker:prod": "docker compose -f docker-compose.prod.yml -f docker-compose.saas.yml up -d",
    "docker:prod:build": "bash scripts/prod-saas-up.sh",
    "docker:build": "docker compose -f docker-compose.prod.yml build",
    "deploy:vm": "bash scripts/vm-prod.sh",
    "build:edge-agent": "pnpm --filter @idrac/edge-agent build",
    "agent:cdn-stage": "bash scripts/stage-agent-cdn.sh",
    "agent:cdn-stage:help": "echo 'Stage CDN files: pnpm agent:cdn-stage. Windows EXE: WIN_EXE=/path/UidracAgentSetup.exe pnpm agent:cdn-stage'",
    "agent:cdn-verify": "bash scripts/verify-agent-cdn.sh",
    "clean": "turbo clean && rm -rf node_modules",
    "version:track": "node scripts/version-track.mjs",
    "release": "bash scripts/release.sh",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@swc/core": "^1.16.2",
    "@swc/register": "^0.1.10",
    "@types/node": "^20.14.0",
    "eslint": "^9.5.0",
    "prettier": "^3.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.15.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^1.6.0"
  }
}
